{
  "name": "fast-loader",
  "version": "1.0.5",
  "description": "Быстрый запуск программ на базе Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:packager": "node build-with-icon.js"
  },
  "author": "meowhiks",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron/packager": "^19.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.3",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "electron-updater": "^6.1.4",
    "extract-file-icon": "^0.3.2"
  },
  "build": {
    "appId": "com.fastloader.app",
    "productName": "FastLoader",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "meowhiks",
      "repo": "fastloader"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "sign": false,
      "signingHashAlgorithms": [],
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
